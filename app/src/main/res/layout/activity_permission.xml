<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/permission_tv_title"
        style="@style/Font_20_000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_65dp"
        android:gravity="center"
        android:text="@string/permission_title"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/permission_btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:src="@drawable/btn_top_close_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/dimen_20dp"
        app:layout_constraintBottom_toTopOf="@id/permission_btn_confirm"
        app:layout_constraintTop_toBottomOf="@id/permission_tv_title">

        <TextView
            style="@style/Font_20_242424"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_msg1" />

        <TextView
            style="@style/Font_14_3D3D3D"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_11dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_30dp"
            android:text="@string/permission_msg1_1" />

        <TextView
            style="@style/Font_20_242424"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_msg2" />

        <TextView
            style="@style/Font_14_3D3D3D"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_11dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_30dp"
            android:text="@string/permission_msg2_1" />

        <TextView
            style="@style/Font_20_242424"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_msg3" />

        <TextView
            style="@style/Font_14_3D3D3D"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_11dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_30dp"
            android:text="@string/permission_msg3_1" />

    </LinearLayout>

    <Button
        android:id="@+id/permission_btn_confirm"
        style="@style/Font_16_FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_60dp"
        android:background="@color/color_primary"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/btn_confirm"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>