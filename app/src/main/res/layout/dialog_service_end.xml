<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/dimen_20dp"
    android:background="@drawable/rectangle_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dimen_20dp">

    <ImageView
        android:id="@+id/dialog_service_end_btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:src="@drawable/btn_close" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_10dp"
        android:src="@drawable/img_circle_warning" />

    <TextView
        style="@style/Font_24_primaryBlack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_end_service_content"
        android:textAlignment="center" />

    <TextView
        style="@style/Font_14_medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:text="@string/dialog_end_service_content2"
        android:textAlignment="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_service_end_btn_exit"
        style="@style/btn_r50_primary_blue"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_50dp"
        android:layout_marginTop="@dimen/dimen_35dp"
        android:layout_marginBottom="@dimen/dimen_46dp"
        android:background="@drawable/rectangle_r50_fill_primary_blue"
        android:paddingHorizontal="@dimen/dimen_50dp"
        android:text="@string/btn_exit"
        app:layout_constraintBottom_toBottomOf="parent" />

</LinearLayout>