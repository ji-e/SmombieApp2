<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.MainActivity"
    tools:openDrawer="end">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen_20dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/logo_txt" />

            <ImageView
                android:id="@+id/main_btn_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:src="@drawable/btn_menu" />
        </RelativeLayout>

        <TextView
            android:id="@+id/main_tv_msg"
            style="@style/Font_24_primaryBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_30dp"
            android:layout_marginBottom="@dimen/dimen_05dp"
            android:text="@string/main_off_msg"
            android:textAlignment="center" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/main_sw_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_22dp"
            android:background="@drawable/switch_selector"
            android:thumb="@null"
            android:track="@null" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_03dp">

            <ImageView
                android:id="@+id/main_img_out_circle"
                android:layout_width="@dimen/dimen_200dp"
                android:layout_height="@dimen/dimen_200dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/dimen_08dp"
                android:src="@drawable/circle_fill_5_primary_blue"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/main_img_inner_circle"
                android:layout_width="@dimen/dimen_280dp"
                android:layout_height="@dimen/dimen_280dp"
                android:layout_marginStart="@dimen/dimen_08dp"
                android:background="@drawable/img_circle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/main_img_logo"
                android:layout_width="@dimen/dimen_100dp"
                android:layout_height="@dimen/dimen_100dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/logo_off"
                app:layout_constraintBottom_toBottomOf="@id/main_img_out_circle"
                app:layout_constraintEnd_toEndOf="@id/main_img_out_circle"
                app:layout_constraintStart_toStartOf="@id/main_img_out_circle"
                app:layout_constraintTop_toTopOf="@id/main_img_out_circle" />

            <ImageView
                android:id="@+id/main_progress"
                android:layout_width="@dimen/dimen_234dp"
                android:layout_height="@dimen/dimen_234dp"
                android:background="@drawable/ring_primary_blue"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/main_img_out_circle"
                app:layout_constraintEnd_toEndOf="@id/main_img_out_circle"
                app:layout_constraintStart_toStartOf="@id/main_img_out_circle"
                app:layout_constraintTop_toTopOf="@id/main_img_out_circle"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/main_txt_start_time"
            style="@style/Font_16_mediumDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_start_time"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/main_lay_start_time"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_50dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:background="@drawable/rectangle_r50_st_light_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen_20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/dimen_08dp"
                android:layout_height="@dimen/dimen_08dp"
                android:layout_marginEnd="@dimen/dimen_10dp"
                android:src="@drawable/circle_fill_primary_blue" />

            <TextView
                android:id="@+id/main_tv_start_time"
                style="@style/Font_16_primaryBlack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="오전 11:20,   02월 07일" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_200dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/dimen_30dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent">

        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="@dimen/dimen_250dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/rectangle_menu_draw"
        android:orientation="vertical"
        app:itemTextColor="#fff"
        tools:visibility="gone">

        <include
            android:id="@+id/main_lay_menu"
            layout="@layout/activity_menu_draw" />
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>