<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/dimen_16dp"
    tools:context=".view.MainActivity">


    <CheckBox
        style="@style/Font_14_000000"
        android:id="@+id/main_ckb_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_service_on"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/main_tv_service_state"
        style="@style/Font_14_000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_service_state"
        android:layout_marginTop="@dimen/dimen_26dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/main_ckb_service" />

    <TextView
        android:id="@+id/main_tv_step_cnt"
        style="@style/Font_14_000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_step_cnt"
        app:layout_constraintTop_toBottomOf="@id/main_ckb_service" />

</androidx.constraintlayout.widget.ConstraintLayout>