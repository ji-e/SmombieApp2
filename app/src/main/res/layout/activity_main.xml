<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/dimen_16dp"
    tools:context=".view.MainActivity">

    <TextView
        android:id="@+id/main_tv_start_time"
        style="@style/Font_16_000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_start_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Switch
        android:id="@+id/main_sw_service"
        style="@style/Font_16_000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:showText="true"
        android:switchTextAppearance="@style/Font_16_000000"
        android:text="@string/main_service_on"
        android:textOff="@string/btn_end"
        android:textOn="@string/btn_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_tv_start_time" />


    <Button
        android:id="@+id/main_btn_log"
        style="@style/Font_14_FFFFFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_log"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_sw_service" />

    <Button
        android:id="@+id/main_btn_bug"
        style="@style/Font_14_FFFFFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_bug"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_btn_log" />

    <EditText
        android:id="@+id/main_et_email"
        style="@style/Font_14_000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/main_email_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_btn_bug" />

    <Button
        android:id="@+id/main_btn_email"
        style="@style/Font_14_FFFFFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/btn_email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_et_email" />

</androidx.constraintlayout.widget.ConstraintLayout>