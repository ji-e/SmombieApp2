<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.intro.PrivacyActivity">

    <ImageView
        android:id="@+id/privacy_btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:src="@drawable/btn_top_close_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/privacy_tv_title"
        style="@style/Font_20_000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_65dp"
        android:gravity="center"
        android:text="@string/privacy_title"
        app:layout_constraintTop_toTopOf="parent" />

    <WebView
        android:id="@+id/privacy_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/privacy_btn_agree"
        app:layout_constraintTop_toBottomOf="@id/privacy_tv_title" />

    <Button
        android:id="@+id/privacy_btn_agree"
        style="@style/Font_16_FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_60dp"
        android:background="@color/color_primary"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/btn_agree"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>