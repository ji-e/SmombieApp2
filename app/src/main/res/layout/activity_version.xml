<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.VersionActivity">

    <TextView
        android:id="@+id/version_tv_title"
        style="@style/Font_18_primaryBlack"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_56dp"
        android:gravity="center"
        android:text="@string/version_title"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/version_btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_20dp"
        android:src="@drawable/btn_arrow_left"
        app:layout_constraintBottom_toBottomOf="@id/version_tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/version_tv_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/version_tv_title">

        <ImageView
            android:layout_width="@dimen/dimen_60dp"
            android:layout_height="@dimen/dimen_60dp"
            android:src="@drawable/logo_on" />

        <TextView
            android:id="@+id/version_tv"
            style="@style/Font_14_mediumDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_80dp"
            android:text="@string/version_msg" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>