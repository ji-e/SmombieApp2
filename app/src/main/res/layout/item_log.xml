<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_10dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/dimen_05dp"
    android:paddingHorizontal="@dimen/dimen_20dp">

    <TextView
        android:id="@+id/log_item_start"
        style="@style/Font_16_000000"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:text="@string/log_start_time" />

    <TextView
        android:id="@+id/log_item_end"
        style="@style/Font_16_000000"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:text="@string/log_end_time" />

    <TextView
        android:id="@+id/log_item_time"
        style="@style/Font_16_000000"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:text="@string/log_time" />

    <TextView
        android:id="@+id/log_item_step"
        style="@style/Font_16_000000"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:text="@string/log_step" />
</LinearLayout>
