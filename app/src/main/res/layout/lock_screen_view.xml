<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_242424"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/dimen_20dp">

    <ImageView
        android:id="@+id/lock_img_logo"
        android:layout_width="@dimen/dimen_40dp"
        android:layout_height="@dimen/dimen_40dp"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:src="@drawable/smombie_logo" />


    <TextView
        style="@style/Font_20_FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_40dp"
        android:gravity="center"
        android:text="@string/lock_screen_view_title"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        style="@style/Font_14_FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:gravity="center"
        android:text="@string/lock_screen_view_step_cnt"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/lock_screen_step_cnt"
        style="@style/Font_74_FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:layout_marginBottom="@dimen/dimen_40dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="0" />

    <TextView
        android:id="@+id/lock_screen_msg"
        style="@style/Font_14_FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:layout_marginBottom="@dimen/dimen_10dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/lock_screen_view_msg" />


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <TextView
        android:id="@+id/lock_screen_btn_emergency"
        style="@style/Font_16_FFFFFF"
        android:layout_width="@dimen/dimen_80dp"
        android:layout_height="@dimen/dimen_80dp"
        android:background="@drawable/circle"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dimen_20dp"
        android:text="@string/btn_emergency"
        android:textStyle="bold" />


</LinearLayout>