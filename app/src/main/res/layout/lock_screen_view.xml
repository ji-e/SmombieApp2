<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primary_blue"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_55dp"
        android:src="@drawable/lock_logo" />


    <TextView
        android:id="@+id/lock_tv_title"
        style="@style/Font_24_primaryWhite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:gravity="center"
        android:text="@string/lock_screen_view_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_tv_subtitle"
        style="@style/Font_24_primaryWhite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_03dp"
        android:gravity="center"
        android:text="@string/lock_screen_view_subtitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_35dp">

        <ImageView
            android:id="@+id/lock_img_out_circle"
            android:layout_width="@dimen/dimen_200dp"
            android:layout_height="@dimen/dimen_200dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dimen_08dp"
            android:background="@drawable/circle_fill_10_primary_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="@dimen/dimen_280dp"
            android:layout_height="@dimen/dimen_280dp"
            android:layout_marginStart="@dimen/dimen_08dp"
            android:background="@drawable/img_circle2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/Font_16_mediumDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lock_screen_view_step_cnt"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/lock_tv_step_cnt"
            app:layout_constraintEnd_toEndOf="@id/lock_img_out_circle"
            app:layout_constraintStart_toStartOf="@id/lock_img_out_circle" />

        <TextView
            android:id="@+id/lock_tv_step_cnt"
            style="@style/Font_72_primaryBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:gravity="center"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/lock_img_out_circle"
            app:layout_constraintEnd_toEndOf="@id/lock_img_out_circle"
            app:layout_constraintStart_toStartOf="@id/lock_img_out_circle"
            app:layout_constraintTop_toTopOf="@id/lock_img_out_circle"
            android:text="00" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/lock_btn_emergency"
        style="@style/btn_r50_primary_white"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_40dp"
        android:layout_marginBottom="@dimen/dimen_10dp"
        android:background="@drawable/rectangle_r50_fill_primary_white"
        android:paddingHorizontal="@dimen/dimen_30dp"
        android:text="@string/btn_emergency"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        style="@style/Font_14_primaryWhite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_70dp"
        android:text="@string/lock_screen_view_msg"
        android:textAlignment="center" />


</LinearLayout>