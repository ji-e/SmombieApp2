<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rectangle_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_margin="@dimen/dimen_20dp"
    android:paddingHorizontal="@dimen/dimen_20dp">

    <ImageView
        android:id="@+id/dialog_history_sent_btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:src="@drawable/btn_close" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_10dp"
        android:src="@drawable/img_email_dr" />

    <TextView
        style="@style/Font_18_primaryBlack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_history_send_content"
        android:textAlignment="center" />

    <EditText
        android:id="@+id/dialog_history_send_edt"
        style="@style/Font_16_primaryBlack"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_50dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:background="@drawable/rectangle_r50_st_light_medium"
        android:hint="@string/dialog_history_send_hint"
        android:paddingHorizontal="@dimen/dimen_10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_history_send_btn"
        style="@style/btn_r50_primary_blue"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_50dp"
        android:layout_marginTop="@dimen/dimen_30dp"
        android:layout_marginBottom="@dimen/dimen_46dp"
        android:background="@drawable/rectangle_r50_fill_primary_blue"
        android:paddingHorizontal="@dimen/dimen_50dp"
        android:text="@string/btn_email2"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent" />

</LinearLayout>